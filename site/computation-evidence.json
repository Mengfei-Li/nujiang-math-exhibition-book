heading","depth":2,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"带着证据意识进入两道题","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"TWJto52x2S"}],"identifier":"id","label":"带着证据意识进入两道题","html_id":"id-8","implicit":true,"key":"CQGnsDSnXD"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"一个程序随机试了十万组 8 卡片方案，没有找到安全路线。最稳妥的表述是：","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"IIvO8o9zTW"}],"key":"sdgCxwG0oZ"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"A. 8 张卡片绝对不可能；","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"OYwI4sM3wV"},{"type":"break","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"cbwGYv7vCI"},{"type":"text","value":"B. 8 张卡片大概率不可能，所以可以当定理；","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"E7Nql2ZU5Q"},{"type":"break","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"krRWvS3DzZ"},{"type":"text","value":"C. 在这十万组与当前搜索设置中未找到方案，这为不可能性提供证据，但不是证明。","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"PWcpZ1WMl4"}],"key":"FYmFMXeCIT"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"答案是C。这个判断会在后面不断出现：题一的动画和随机搜索不能冒充连续安全证明，题二的可行边集也不能单独冒充最优值。基础工具到这里结束，接下来正式进入机器人的障碍阵列。","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"b6SxLruByi"}],"key":"hY4rzn1U4G"}],"key":"XBJc8f2iXt"}],"key":"pQ8LAeZWDF"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"数学工具箱：够用、可画、能解释","url":"/math-toolbox","group":"先学会读研究"},"next":{"title":"题一开场：题目到底要机器人完成什么？","url":"/story-and-model","group":"长期题一：机器人怎样安全穿行"}}},"domain":"h