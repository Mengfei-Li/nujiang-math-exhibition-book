lue":"def layer(a,b): return max(abs(a),abs(b),abs(a+b))\ndef xy(a,b): return 20*a+10*b,10*math.sqrt(3)*b\nn=3\npts=[(a,b,*xy(a,b),layer(a,b)) for a in range(-n,n+1) for b in range(-n,n+1) if layer(a,b)<=n]\nfig,ax=plt.subplots(figsize=(7,6))\nfor a,b,x,y,ell in pts:\n    ax.add_patch(Circle((x,y),8,alpha=.12,color=plt.cm.viridis(ell/n if n else 0)))\n    ax.plot(x,y,'o',color=plt.cm.viridis(ell/n if n else 0),ms=4)\nax.set_aspect('equal');ax.set_title(f'第 0 到第 {n} 层，共 {len(pts)} 个中心');ax.axis('off');plt.show()","key":"f56MYspTeT"},{"type":"outputs","id":"XSk4NGPcqIoGR4CeG8xdf","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 700x600 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"2747c71d9e3d0cadbd877af6c04b31f9","path":"/nujiang-math-exhibition-book/build/2747c71d9e3d0cadbd877af6c04b31f9.png"}}},"key":"Es8xqp4eT8"}],"key":"LiHTgTPdJq"}],"key":"CAxY4YMnJy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"实验 C：采样密度不是证明","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TkMsTLN7Y5"}],"identifier":"id-c","label":"实验 C：采样密度不是证明","html_id":"id-c","implicit":true,"key":"cXzlktnJem"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"下面故意造一个很窄的危险凹口。稀疏采样可能完全看不到它；加密后才暴露。真实论文使用连续区间证书解决这种问题。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EZ95fmWDxj"}],"key":"iCSpoa0jtc"}],"key":"AjdtQsHVZG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-09T19:55:23.394417Z","iopub.status.busy":"2026-08-09T19:55:23.394025Z","iopub.status.idle":"2026-08-09T19:55:23.634142Z","shell.execute_reply":"2026-08-09T19:55:23.633105Z"}},"children":[