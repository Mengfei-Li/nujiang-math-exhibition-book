layer(a,b): return max(abs(a),abs(b),abs(a+b))\ndef xy(a,b): return 20*a+10*b,10*math.sqrt(3)*b\nn=3\npts=[(a,b,*xy(a,b),layer(a,b)) for a in range(-n,n+1) for b in range(-n,n+1) if layer(a,b)<=n]\nfig,ax=plt.subplots(figsize=(7,6))\nfor a,b,x,y,ell in pts:\n    ax.add_patch(Circle((x,y),8,alpha=.12,color=plt.cm.viridis(ell/n if n else 0)))\n    ax.plot(x,y,'o',color=plt.cm.viridis(ell/n if n else 0),ms=4)\nax.set_aspect('equal');ax.set_title(f'第 0 到第 {n} 层，共 {len(pts)} 个中心');ax.axis('off');plt.show()","key":"DEW2DHwYhC"},{"type":"outputs","id":"ohH-46yLGuE-4sfZYBFWh","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2747c71d9e3d0cadbd877af6c04b31f9","path":"/nujiang-math-exhibition-book/build/2747c71d9e3d0cadbd877af6c04b31f9.png"},"text/plain":{"content":"<Figure size 700x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"L4EiMWbQtj"}],"key":"XXOOQk351K"}],"key":"V6FRveB7al"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"实验 C：采样密度不是证明","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RqKSBKbg4X"}],"identifier":"id-c","label":"实验 C：采样密度不是证明","html_id":"id-c","implicit":true,"key":"mBkAPWh0JQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"下面故意造一个很窄的危险凹口。稀疏采样可能完全看不到它；加密后才暴露。真实论文使用连续区间证书解决这种问题。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ae9feHiBKB"}],"key":"jb6jeH6Snj"}],"key":"Uz7vYYgABj"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-09T19:55:23.394417Z","iopub.status.busy":"2026-08-09T19:55:23.394025Z","iopub.status.idle":"2026-08-09T19:55:23.634142Z","shell.execute_reply":"2026-08-09T19:55:23.633105Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def clearance(t): return 9.03-0.05*np.exp(-((t-0.503)/0.004)**2)\nfig,ax=plt.subplots(figsize=(8,4))\nfor count,color in [(20,'#E4572E'),(2000,'#145DA0')]:\n    t=np.linspace(0,1,count);ax.plot(t,clearance(t),'o-' if count==20 else '-',ms=3,label=f'{count} 个采样点',color=color)\nax.axhline(9,color='black',ls='--',label='安全边界 9')\nax.set_ylim(8.97,9.04);ax.set_xlabel('时间');ax.set_ylabel('距离');ax.legend();ax.grid(alpha=.2);plt.show()\nprint('20点最小值:',clearance(np.linspace(0,1,20)).min())\nprint('2000点最小值:',clearance(np.linspace(0,1,2000)).min())","key":"sGaFk7PSt9"},{"type":"outputs","id":"0BavSs4-TQgSPCTS1VwLR","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"73cdef1014793e2c91d1105d7a2419ac","path":"/nujiang-math-exhibition-book/build/73cdef1014793e2c91d1105d7a2419ac.png"},"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"JgvV5mPJS7"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"20点最小值: 9.03\n2000点最小值: 8.98019279623968\n"},"children":[],"key":"Hn5OrQ8fTs"}],"key":"fZek3m5W7i"}],"key":"ZJ0B5g1uV3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"结论记录","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gXxd1dg6vk"}],"identifier":"id","label":"结论记录","html_id":"id","implicit":true,"key":"P0aQ8NQC0c"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"半径相加把圆—圆碰撞化成点—圆判断。","position":{"start":{"line":3,"column":1},"end":{